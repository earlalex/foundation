rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@earlalex\\.com$')
      );
    }

    function isEditorOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'editor' ||
        request.auth.token.email.matches('.*@earlalex\\.com$')
      );
    }

    // User Directory & Profiles (Strict privacy)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Offline Outbox Queue (Authenticated queue processing)
    match /foundation_outbox/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Custom Dynamic Pages
    match /pages/{pageId} {
      allow read: if resource.data.access.visibility == 'public' || resource.data.access == null || isEditorOrAdmin();
      allow write: if isEditorOrAdmin();
    }

    // CMS & Catalog Content
    match /content/{contentId} {
      allow read: if resource.data.access.visibility == 'public' || resource.data.access == null || isAuthenticated();
      allow write: if isEditorOrAdmin();
    }

    // Site Settings & Configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Invoices & Financial Records
    match /invoices/{invoiceId} {
      allow read, write: if isAuthenticated();
    }

    match /finances_expenses/{expId} {
      allow read, write: if isEditorOrAdmin();
    }

    match /finances_payroll/{payId} {
      allow read, write: if isAdmin();
    }

    match /finances_budgets/{budgetId} {
      allow read, write: if isAdmin();
    }

    match /finances_employees/{empId} {
      allow read, write: if isAdmin();
    }

    match /splits/{splitId} {
      allow read, write: if isEditorOrAdmin();
    }

    match /earnings/{earningId} {
      allow read, write: if isAdmin();
    }

    // Bookings, Registrations & Purchases
    match /appointments/{apptId} {
      allow read, write: if isAuthenticated();
    }

    match /registrations/{regId} {
      allow read, write: if isAuthenticated();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isAuthenticated();
    }

    // Chat Logs & Spark AI Tasks
    match /chat_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    match /spark_tasks/{taskId} {
      allow read, write: if isEditorOrAdmin();
    }

    match /hipaa_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Security Scans & Audit Logs (Admin only)
    match /security_scans/{scanId} {
      allow read, write: if isAdmin();
    }

    // Kanban Tasks & Growth Workflows
    match /kanban_tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /marketing_workflows/{workflowId} {
      allow read, write: if isEditorOrAdmin();
    }

    match /marketing_segments/{segmentId} {
      allow read, write: if isEditorOrAdmin();
    }

    match /email_templates/{templateId} {
      allow read, write: if isEditorOrAdmin();
    }

    // Password Vault Credentials (Strict Admin Access)
    match /vault_credentials/{credId} {
      allow read, write: if isAdmin();
    }
  }
}