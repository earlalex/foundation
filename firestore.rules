// Secure firestore.rules for Foundation - Updated for Setup State and Public Reads
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for Admin evaluation
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in get(/databases/$(database)/documents/settings/config).data.adminEmails;
    }

    // Global Site Configuration (Public Read, Admin Write)
    match /settings/config {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public vs Gated Content Access
    match /content/{docId} {
      allow read: if resource.data.access.visibility == 'public' ||
                   (request.auth != null && resource.data.access.visibility == 'authenticated') ||
                   (request.auth != null && request.auth.token.role == resource.data.access.visibility);
      allow write: if isAdmin();
    }

    // User Profile Protection (Users can read/write their own profile; Admins have full access)
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Immutable Security Audit Logs (Read/Write restricted to authenticated Admins)
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Fallback rule to ensure authenticated admins are never locked out of arbitrary collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
