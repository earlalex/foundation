// Secure firestore.rules for Foundation - Updated for Setup State and Public Reads
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function for Admin evaluation
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.email in get(/databases/$(database)/documents/settings/config).data.adminEmails;
    }

    // Global Site Configuration (Public Read, Admin Write)
    match /settings/config {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // =========================================================================
    // 2. USER DIRECTORY, PROFILES & AFFILIATE LOGS
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (isSelf(userId) || isAdmin() || isEditor());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isSelf(userId) || isAdmin());
      allow delete: if isAdmin();

      // Course Progress Subcollection
      match /course_progress/{courseId} {
        allow read, write: if isAuthenticated() && (isSelf(userId) || isAdmin());
      }

      // User Tickets Subcollection
      match /tickets/{ticketId} {
        allow read: if isAuthenticated() && (isSelf(userId) || isAdmin() || isEditor());
        allow write: if isAuthenticated() && (isSelf(userId) || isAdmin());
      }
    }

    // =========================================================================
    // 3. INVOICES, PURCHASES & ORDERS
    // =========================================================================
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        resource.data.customerEmail == request.auth.token.email || 
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isEditor()
      );
      allow create, update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow read: if isAuthenticated() && (
        resource.data.email == request.auth.token.email || 
        resource.data.userId == request.auth.uid ||
        isAdmin() ||
        isEditor()
      );
      allow create, update, delete: if isAdmin();
    }

    match /downloads/{downloadId} {
      allow read: if isAuthenticated() && (
        resource.data.userEmail == request.auth.token.email || 
        isAdmin()
      );
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. EVENT REGISTRATIONS & TICKET PASSES
    // =========================================================================
    match /registrations/{registrationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.email == request.auth.token.email ||
        isEditor() || 
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Public vs Gated Content Access
    match /content/{docId} {
      allow read: if resource.data.access.visibility == 'public' ||
                   (request.auth != null && resource.data.access.visibility == 'authenticated') ||
                   (request.auth != null && request.auth.token.role == resource.data.access.visibility);
      allow write: if isAdmin();
    }

    // User Profile Protection (Users can read/write their own profile; Admins have full access)
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Immutable Security Audit Logs (Read/Write restricted to authenticated Admins)
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Fallback rule to ensure authenticated admins are never locked out of arbitrary collections
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
