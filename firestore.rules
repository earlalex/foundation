rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@earlalex.com' ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email in get(/databases/$(database)/documents/settings/config).data.adminEmails
      );
    }

    function isEditor() {
      return isAuthenticated() && (
        request.auth.token.role == 'editor' ||
        isAdmin()
      );
    }

    match /settings/config {
      allow read: if true;
      allow write: if !exists(/databases/$(database)/documents/settings/config) || isAdmin();
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /content/{contentId} {
      allow read: if true;
      allow write: if isAdmin() || isEditor();
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if isAdmin() || isEditor();
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}