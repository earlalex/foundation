rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && (
        request.auth.uid == userId ||
        request.auth.token.email == userId ||
        (request.resource != null && (
          ('email' in request.resource.data && request.resource.data.email == request.auth.token.email) ||
          ('id' in request.resource.data && request.resource.data.id == request.auth.uid) ||
          ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid)
        )) ||
        (resource != null && (
          ('email' in resource.data && resource.data.email == request.auth.token.email) ||
          ('id' in resource.data && resource.data.id == request.auth.uid) ||
          ('userId' in resource.data && resource.data.userId == request.auth.uid)
        ))
      );
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'admin@earlalex.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          getUserProfile().role == 'admin')
      );
    }

    function isEditorOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'editor' ||
        request.auth.token.email == 'admin@earlalex.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (getUserProfile().role == 'admin' || getUserProfile().role == 'editor' || getUserProfile().isAdmin == true))
      );
    }

    function isRequestIdentityValid() {
      return request.resource == null || (
        (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid) &&
        (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email) &&
        (!('userEmail' in request.resource.data) || request.resource.data.userEmail == request.auth.token.email) &&
        (!('customerEmail' in request.resource.data) || request.resource.data.customerEmail == request.auth.token.email)
      );
    }

    function isDocOwner() {
      return isAuthenticated() && (
        resource != null ? (
          (resource.data.userId == request.auth.uid ||
           resource.data.email == request.auth.token.email ||
           resource.data.userEmail == request.auth.token.email ||
           resource.data.customerEmail == request.auth.token.email) &&
          isRequestIdentityValid()
        ) : (
          isRequestIdentityValid() && request.resource != null && (
            ('userId' in request.resource.data && request.resource.data.userId == request.auth.uid) ||
            ('email' in request.resource.data && request.resource.data.email == request.auth.token.email) ||
            ('userEmail' in request.resource.data && request.resource.data.userEmail == request.auth.token.email) ||
            ('customerEmail' in request.resource.data && request.resource.data.customerEmail == request.auth.token.email)
          )
        )
      );
    }

    // User Directory & Profiles (Strict privacy & privilege protection)
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin() || (
        isOwner(userId) && isRequestIdentityValid() && (
          resource == null
            ? (request.resource.data.role != 'admin' &&
               request.resource.data.role != 'editor' &&
               (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin != true))
            : (request.resource == null || (
                (request.resource.data.role != 'admin' && request.resource.data.role != 'editor' || request.resource.data.role == resource.data.role) &&
                (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin != true || ('isAdmin' in resource.data && resource.data.isAdmin == true))
              ))
        )
      );
    }

    // Offline Outbox Queue (Authenticated queue processing)
    match /foundation_outbox/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Custom Dynamic Pages
    match /pages/{pageId} {
      allow read: if resource.data.access.visibility == 'public' || resource.data.access == null || isEditorOrAdmin();
      allow write: if isEditorOrAdmin();
    }

    // CMS & Catalog Content
    match /content/{contentId} {
      allow read: if resource.data.access.visibility == 'public' || resource.data.access == null || isAuthenticated();
      allow write: if isEditorOrAdmin();
    }

    // Site Settings & Configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Invoices & Financial Records
    match /invoices/{invoiceId} {
      allow read, write: if isDocOwner() || isEditorOrAdmin();
    }

    match /finances_expenses/{expId} {
      allow read, write: if isEditorOrAdmin();
    }

    match /finances_payroll/{payId} {
      allow read, write: if isAdmin();
    }

    match /finances_budgets/{budgetId} {
      allow read, write: if isAdmin();
    }

    match /finances_employees/{empId} {
      allow read, write: if isAdmin();
    }

    match /splits/{splitId} {
      allow read, write: if isEditorOrAdmin();
    }

    match /earnings/{earningId} {
      allow read, write: if isAdmin();
    }

    // Bookings, Registrations & Purchases
    match /appointments/{apptId} {
      allow read, write: if isDocOwner() || isEditorOrAdmin();
    }

    match /registrations/{regId} {
      allow read, write: if isDocOwner() || isEditorOrAdmin();
    }

    match /purchases/{purchaseId} {
      allow read, write: if isDocOwner() || isEditorOrAdmin();
    }

    // Chat Logs & Spark AI Tasks
    match /chat_logs/{logId} {
      allow read, write: if isDocOwner() || isEditorOrAdmin();
    }

    match /spark_tasks/{taskId} {
      allow read, write: if isEditorOrAdmin();
    }

    match /hipaa_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Security Scans & Audit Logs (Admin only)
    match /security_scans/{scanId} {
      allow read, write: if isAdmin();
    }

    // Kanban Tasks & Growth Workflows
    match /kanban_tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /marketing_workflows/{workflowId} {
      allow read, write: if isEditorOrAdmin();
    }

    match /marketing_segments/{segmentId} {
      allow read, write: if isEditorOrAdmin();
    }

    match /email_templates/{templateId} {
      allow read, write: if isEditorOrAdmin();
    }

    // Password Vault Credentials (Strict Admin Access)
    match /vault_credentials/{credId} {
      allow read, write: if isAdmin();
    }
  }
}