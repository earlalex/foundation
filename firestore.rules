rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@earlalex\\.com$')
      );
    }

    // User Directory & Profiles (Strict privacy)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Offline Outbox Queue (Authenticated queue processing)
    match /foundation_outbox/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Custom Dynamic Pages
    match /pages/{pageId} {
      allow read: if resource.data.access.visibility == 'public' || resource.data.access == null || isAdmin();
      allow write: if isAdmin();
    }

    // CMS & Catalog Content
    match /content/{contentId} {
      allow read: if resource.data.access.visibility == 'public' || resource.data.access == null || isAuthenticated();
      allow write: if isAdmin();
    }

    // Site Settings & Configuration
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Security Scans & Audit Logs (Admin only)
    match /security_scans/{scanId} {
      allow read, write: if isAdmin();
    }

    // Kanban Tasks & Growth Workflows
    match /kanban_tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    match /marketing_workflows/{workflowId} {
      allow read, write: if isAdmin();
    }

    match /marketing_segments/{segmentId} {
      allow read, write: if isAdmin();
    }

    match /email_templates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Password Vault Credentials (Strict Admin Access)
    match /vault_credentials/{credId} {
      allow read, write: if isAdmin();
    }
  }
}