{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/feed",
      "destination": "/api/rss"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/|assets/|components/|core/|pages/|router/|schemas/|styles/|tests/|utils/|_worker.bundle|index.js|sw.js|favicon.ico|manifest.json).*)$",
      "destination": "/index.html"
    }
  ]
}
